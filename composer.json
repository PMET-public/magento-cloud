{
    "name": "magento/project-enterprise-edition",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "license": [
        "proprietary"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true,
            "cweagans/composer-patches": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "version": "2.4.8",
    "require": {
        "amasty/base": "1.15.2.x-dev",
        "amasty/module-advanced-conditions": "1.5.10.x-dev",
        "amasty/module-banners-lite": "1.2.0.x-dev",
        "amasty/module-salesrulewizard": "1.0.5.x-dev",
        "amasty/module-special-promo": "2.13.0.x-dev",
        "amasty/module-special-promo-pro": "2.13.0.x-dev",
        "amasty/promo": "2.16.1.x-dev",
        "amasty/rgrid": "1.0.9.x-dev",
        "community-engineering/language-ar_sa": "*",
        "community-engineering/language-de_de": "*",
        "community-engineering/language-es_es": "*",
        "community-engineering/language-es_mx": "*",
        "community-engineering/language-fr_fr": "*",
        "community-engineering/language-hi_in": "*",
        "community-engineering/language-it_it": "*",
        "community-engineering/language-ja_jp": "*",
        "community-engineering/language-ko_kr": "*",
        "community-engineering/language-nl_nl": "*",
        "community-engineering/language-pt_br": "*",
        "community-engineering/language-sr_sp": "*",
        "community-engineering/language-zh_cn": "*",
        "cweagans/composer-patches": "~1.0",
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "^2.0.4",
        "magento/extension-b2b": "^1.5",
        "magento/live-search": "^4.0",
        "magento/module-page-builder-product-recommendations": "^6.0",
        "magento/module-visual-product-recommendations": "^6.0",
        "magento/product-enterprise-edition": ">=2.4.8 <2.4.9",
        "magento/product-recommendations": "^6.0",
        "magentoese/module-admin-configurations": "dev-master",
        "magentoese/module-autofill": "dev-master",
        "magentoese/module-data-install": "dev-master",
        "magentoese/module-data-install-graph-ql": "dev-master",
        "magentoese/module-instorepickup": "dev-master",
        "magentoese/module-keep-on-wishlist": "dev-master",
        "magentoese/module-productbadge": "dev-master",
        "magentoese/module-saas-data-management": "dev-master",
        "magentoese/module-sctools": "dev-master",
        "magentoese/module-switcherlogos": "dev-master",
        "magentoese/module-themecustomizer": "dev-master",
        "magentoese/theme-brentmill": "dev-master",
        "magentoese/theme-frontend-custom": "dev-master",
        "magentoese/theme-frontend-venia": "dev-master",
        "opensearch-project/opensearch-php": "^2.3.0",
        "paradoxlabs/authnetcim": "5.1.3.x-dev",
        "paradoxlabs/stripe": "3.0.0.x-dev",
        "paradoxlabs/subscriptions": "3.7.0.x-dev",
        "paradoxlabs/tokenbase": "4.7.2.x-dev",
        "wikimedia/less.php": "~5.0.0"
    },
    "autoload": {
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ],
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "psr-4": {
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        }
    },
    "require-dev": {
        "allure-framework/allure-phpunit": "^2",
        "dealerdirect/phpcodesniffer-composer-installer": "^0.7 || ^1.0",
        "dg/bypass-finals": "^1.4",
        "friendsofphp/php-cs-fixer": "^3.22",
        "lusitanian/oauth": "^0.8",
        "magento/magento-coding-standard": "*",
        "magento/magento2-functional-testing-framework": "^4.7",
        "pdepend/pdepend": "^2.12",
        "phpmd/phpmd": "^2.13",
        "phpstan/phpstan": "^1.9",
        "phpunit/phpunit": "^9.5",
        "sebastian/phpcpd": "^6.0",
        "squizlabs/php_codesniffer": "^3.6",
        "symfony/finder": "^6.4",
        "mage2tv/magento-cache-clean": "^1.0"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {"type": "vcs", "url": "https://github.com/magento-l10n/language-es_MX"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-advanced-conditions"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-banners-lite"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-base"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-free-gift"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-rules-grid"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-salesrulewizard"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-special-promotions-pro"},
        {"type": "vcs", "url": "https://github.com/PMET-public/amasty-module-special-promotions"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-admin-configurations"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-autofill"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-data-install"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-data-install-graphql"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-instorepickup"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-keep-on-wishlist"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-productbadge"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-saas-data-management"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-sctools"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-switcherlogos"},
        {"type": "vcs", "url": "https://github.com/PMET-public/module-themecustomizer"},
        {"type": "vcs", "url": "https://github.com/PMET-public/paradoxlabs-authnetcim"},
        {"type": "vcs", "url": "https://github.com/PMET-public/paradoxlabs-stripe"},
        {"type": "vcs", "url": "https://github.com/PMET-public/paradoxlabs-subscriptions"},
        {"type": "vcs", "url": "https://github.com/PMET-public/paradoxlabs-tokenbase"},
        {"type": "vcs", "url": "https://github.com/PMET-public/theme-brentmill"},
        {"type": "vcs", "url": "https://github.com/PMET-public/theme-frontend-custom"},
        {"type": "vcs", "url": "https://github.com/PMET-public/theme-frontend-venia"},
        {"type": "composer", "url": "https://repo.magento.com/", "exclude": ["community-engineering/language-ja_jp","paradoxlabs/tokenbase"]}
    ],
    "extra": {
        "magento-force": "override",
        "composer-exit-on-patch-failure": true,
        "patches-file": "patches.json"
    }
}
