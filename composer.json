{
    "name": "magento/magento-cloud-template",
    "description": "eCommerce Platform for Growth (Enterprise Edition)",
    "type": "project",
    "version": "2.4.6",
    "license": [
        "proprietary"
    ],
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "laminas/laminas-dependency-plugin": true,
            "magento/*": true,
            "php-http/discovery": true
        },
        "preferred-install": "dist",
        "sort-packages": true
    },
    "repositories": [
        {"type": "git", "url": "git@github.com:PMET-public/ece-tools.git"},
        {"type": "git", "url": "git@github.com:PMET-public/magento-cloud-docker.git"},
        {"type": "git", "url": "git@github.com:PMET-public/magento-scripts.git"},
        {"type": "git", "url": "git@github.com:PMET-public/module-data-install.git"},
        {"type": "git", "url": "git@github.com:PMET-public/module-data-install-graphql.git"},
        {"type": "git", "url": "git@github.com:PMET-public/module-saas-data-management.git"},
        {"type": "git", "url": "git@github.com:PMET-public/vertical-data-bodea.git"},
        {"type": "composer", 
            "url": "https://repo.magento.com/",
            "canonical": false
        },
        {"type": "composer", 
            "url": "https://connect20-qa01.magedevteam.com/" 
        }
        
    ],
    "require": {
        "magento/composer-dependency-version-audit-plugin": "~0.1",
        "magento/composer-root-update-plugin": "~2.0",
        "magento/extension-b2b": "1.4.0-beta102",
        "magento/live-search": "^3.0",
        "magento/magento-cloud-docker": "1.3.5.x-dev",
        "magento/magento-cloud-metapackage": "2.4.6",
        "magento/module-page-builder-product-recommendations": "^2.0",
        "magento/module-visual-product-recommendations": "^2.0",
        "magento/product-recommendations": "^5.0",
        "magentoese/ece-tools": "2002.1.14.x-dev",
        "magentoese/magento-scripts": "2.3.0.x-dev",
        "magentoese/module-data-install": "dev-develop",
        "magentoese/module-data-install-graph-ql": "dev-master",
        "magentoese/module-saas-data-management": "dev-master",
        "magentoese/vertical-data-bodea": "dev-main"
    },
    "suggest": {
        "ext-pcntl": "Need for run processes in parallel mode"
    },
    "conflict": {
        "gene/bluefoot": "*"
    },
    "autoload": {
        "psr-4": {
            "Magento\\": "app/code/Magento/",
            "Magento\\Framework\\": "lib/internal/Magento/Framework/",
            "Magento\\Setup\\": "setup/src/Magento/Setup/"
        },
        "psr-0": {
            "": [
                "app/code/",
                "generated/code/"
            ]
        },
        "files": [
            "app/etc/NonComposerComponentRegistration.php"
        ],
        "exclude-from-classmap": [
            "**/dev/**",
            "**/update/**",
            "**/Test/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Magento\\PhpStan\\": "dev/tests/static/framework/Magento/PhpStan/",
            "Magento\\Sniffs\\": "dev/tests/static/framework/Magento/Sniffs/",
            "Magento\\TestFramework\\Inspection\\": "dev/tests/static/framework/Magento/TestFramework/Inspection/",
            "Magento\\TestFramework\\Utility\\": "dev/tests/static/framework/Magento/TestFramework/Utility/",
            "Magento\\Tools\\": "dev/tools/Magento/Tools/",
            "Magento\\Tools\\Sanity\\": "dev/build/publication/sanity/Magento/Tools/Sanity/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "component_paths": {
            "trentrichardson/jquery-timepicker-addon": "lib/web/jquery/jquery-ui-timepicker-addon.js",
            "components/jquery": [
                "lib/web/jquery.js",
                "lib/web/jquery/jquery.min.js",
                "lib/web/jquery/jquery-migrate.js"
            ],
            "blueimp/jquery-file-upload": "lib/web/jquery/fileUploader",
            "components/jqueryui": [
                "lib/web/jquery/jquery-ui.js"
            ],
            "twbs/bootstrap": [
                "lib/web/jquery/jquery.tabs.js"
            ],
            "tinymce/tinymce": "lib/web/tiny_mce_5"
        },
        "magento-force": true,
        "magento-deploystrategy": "copy",
        "magento-deploy-ignore": {
            "*": [
                "/.gitignore"
            ]
        }
    },
    "scripts": {
        "generate-schema": [
            "php ./vendor/bin/ece-tools schema:generate || true"
        ],
        "post-autoload-dump" : [
            "# install magerun via curl; composer no longer recommended",
            "curl -sS -o vendor/bin/mr https://files.magerun.net/n98-magerun2-latest.phar && chmod +x vendor/bin/mr"
        ],
        "post-install-cmd" : [
            "# enable error reporting",
            "mv pub/errors/local.xml.sample pub/errors/local.xml || :",
            "@generate-schema",
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../magento/magento-coding-standard/)"
        ],
        "post-update-cmd": [
            "@generate-schema",
            "([ $COMPOSER_DEV_MODE -eq 0 ] || vendor/bin/phpcs --config-set installed_paths ../../magento/magento-coding-standard/)"
        ]
    },
    "require-dev": {
        "mage2tv/magento-cache-clean": "^1.0",
        "magento/magento-coding-standard": "^31.0"
    }
}
